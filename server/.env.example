# Copy this file to .env and adjust the values

PORT=5000

# Local MongoDB (Compass / mongod) or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/gotravel

# Any long random string
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: SMTP settings for booking confirmation emails.
# Leave empty and emails are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GoTravel <no-reply@gotravel.com>"
